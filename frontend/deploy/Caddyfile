# 快分享 · 边缘配置
# 同一域名下：静态资源走 Caddy 本地目录，/api 与 /ws 反代到后端。
# CLOUDROP_BACKEND_UPSTREAM 默认指向 compose 内的 backend 服务；
# 若后端部署在别处，改成 主机:端口 即可（同源，不需要 CORS）。
{$CLOUDROP_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 1MB
    }

    @backend path /api/* /ws/*
    reverse_proxy @backend {$CLOUDROP_BACKEND_UPSTREAM:backend:8000}

    root * /srv
    try_files {path} /index.html
    file_server

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        -Server
    }
}
